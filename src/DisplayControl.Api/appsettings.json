{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ContentStorage": {
    "MaximumObjectBytes": 268435456
  },
  "ContentScanning": {
    "ClamAv": {
      "Host": "127.0.0.1",
      "Port": 3310,
      "TimeoutSeconds": 120
    }
  },
  "DeviceProtocol": {
    "OfflineAllowanceHours": 24
  },
  "AllowedHosts": "*"
}
