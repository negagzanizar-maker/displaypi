<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DisplayControl.DeviceAgent.Tests" />
    <ProjectReference Include="..\DisplayControl.Application\DisplayControl.Application.csproj" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\apps\player-web\dist\index.html')">
    <Content Include="..\..\apps\player-web\dist\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="RequirePlayerAssetsForPublish" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../../apps/player-web/dist/index.html')"
           Text="Player assets are missing. Run npm run build --workspace player-web before publishing the agent." />
  </Target>
</Project>
