[Unit]
Description=Display Control Raspberry Pi agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=display-control-agent
Group=display-control-agent
WorkingDirectory=/opt/display-control/current
ExecStart=/opt/display-control/current/DisplayControl.DeviceAgent
Environment=DOTNET_ENVIRONMENT=Production
EnvironmentFile=/etc/display-control/agent.env
StateDirectory=display-control
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/display-control

[Install]
WantedBy=multi-user.target
