# Copy to /etc/display-control/api.env with mode 0600 and owner root:display-control-api.
# Replace every placeholder through the deployment secret manager. Never commit the real file.
ASPNETCORE_URLS=https://0.0.0.0:8443
AllowedHosts=admin.example.com;devices.example.com
Deployment__InstanceCount=1

Database__Provider=SqlServer
ConnectionStrings__Database="Server=tcp:db.example.com,1433;Database=display_control;User Id=display_control_runtime_login;Password=REPLACE;Encrypt=True;TrustServerCertificate=False"

Security__DataProtectionKeyDirectory=/var/lib/display-control/data-protection
Security__DataProtectionCertificate__PfxPath=/etc/display-control/secrets/data-protection.pfx
Security__DataProtectionCertificate__PfxPassword=REPLACE
Security__TokenDigestPepperBase64=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_IN_BASE64
Security__DeviceCertificateAuthority__PfxPath=/etc/display-control/secrets/device-ca.pfx
Security__DeviceCertificateAuthority__PfxPassword=REPLACE
Security__DeviceCertificateAuthority__IssuedLifetimeDays=90
Security__LicenseSigningKey__PrivateKeyPath=/etc/display-control/secrets/license-signing-key.pem
Security__LicenseSigningKey__Password=REPLACE

Kestrel__Certificates__Default__Path=/etc/display-control/secrets/public-tls.pfx
Kestrel__Certificates__Default__Password=REPLACE

ContentStorage__RootDirectory=/var/lib/display-control/content
ContentStorage__MaximumObjectBytes=268435456
ContentScanning__ClamAv__Host=clamav.internal
ContentScanning__ClamAv__Port=3310
ContentScanning__ClamAv__TimeoutSeconds=120
DeviceProtocol__OfflineAllowanceHours=24

# Enable only after provisioning the separate notification role and testing SMTP.
Notifications__DeliveryEnabled=false
ConnectionStrings__NotificationDatabase="Server=tcp:db.example.com,1433;Database=display_control;User Id=display_control_notification;Password=REPLACE;Encrypt=True;TrustServerCertificate=False"
Notifications__MaximumAttempts=8
Notifications__Smtp__TimeoutSeconds=30

# Heartbeat cleanup is opt-in and requires the dedicated display_control_maintenance login.
Operations__Retention__Enabled=false
ConnectionStrings__MaintenanceDatabase="Server=tcp:db.example.com,1433;Database=display_control;User Id=display_control_maintenance;Password=REPLACE;Encrypt=True;TrustServerCertificate=False"
Operations__Retention__HeartbeatDays=30
Operations__Retention__IntervalMinutes=15
Operations__Retention__BatchSize=1000
